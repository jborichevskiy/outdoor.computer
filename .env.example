# outdoor.computer config. Copy to .env and edit. .env is gitignored.

# Where the SQLite file lives. Default: ~/outdoor/data.db
# OUTDOOR_DB_PATH=/home/jon/outdoor/data.db

# --- Slate router (SNMP) ---
# Find your Slate's LAN IP from your router admin page.
SLATE_HOST=192.168.8.1
# Set the SNMP community string on the Slate to something other than 'public'.
SLATE_COMMUNITY=public
# SNMP ifIndex of the WAN interface. Find it with:
#   snmpwalk -v2c -c $SLATE_COMMUNITY $SLATE_HOST IF-MIB::ifDescr
SLATE_WAN_IFACE=1

# --- Starlink dish (gRPC) ---
STARLINK_ADDR=192.168.100.1:9200

# --- Weather (Open-Meteo, no key needed) ---
# Default is Boulder, CO.
WEATHER_LAT=40.0150
WEATHER_LON=-105.2705

# --- Web server ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Hostname the ESP32 uses to reach the Pi. `outdoor-pi.local` works via mDNS on most LANs.
WEB_PUBLIC_HOST=outdoor-pi.local
